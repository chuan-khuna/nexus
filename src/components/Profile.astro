---
import { Icon } from 'astro-icon/components';
import TimeCard from '@/components/TimeCard.astro';
import { site } from '@/data/site.config';
---

<section class="rounded-xl border border-border bg-card p-6 sm:p-8">
	<div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
		<div class="flex flex-1 flex-col">
			<h1 class="text-xl font-medium sm:text-2xl">
				Hi, I'm <span class="font-bold">{site.firstName}</span>.
			</h1>
			<p class="mt-1 max-w-prose text-foreground/80">{site.tagline}</p>

			<ul class="mt-5 flex flex-col gap-1.5 text-sm text-foreground/80">
				{site.intros.map((intro) => <li>{intro}</li>)}
			</ul>

			<div class="mt-6 flex items-center gap-4">
				<a
					href={site.github}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="GitHub"
					class="inline-flex text-foreground/70 transition-colors hover:text-primary"
				>
					<Icon name="simple-icons:github" class="size-6" />
				</a>
				<a
					href={site.linkedin}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="LinkedIn"
					class="inline-flex text-foreground/70 transition-colors hover:text-primary"
				>
					<Icon name="simple-icons:linkedin" class="size-6" />
				</a>
			</div>
		</div>

		<img
			src={site.avatar}
			alt={site.name}
			width="224"
			height="176"
			class="h-40 w-full rounded-lg object-cover sm:h-44 sm:w-56 sm:shrink-0"
		/>
	</div>

	<div class="mt-6 flex flex-wrap gap-x-10 gap-y-4 border-t border-border pt-5">
		<TimeCard title="Your time" live />
		<TimeCard title="My time" timezone={site.timezone} />
	</div>
</section>
