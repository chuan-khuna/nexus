---
import { site } from '@/data/site.config';
---

<header class="flex flex-col items-center gap-3 text-center">
	<img
		src={site.avatar}
		alt={site.name}
		width="96"
		height="96"
		class="size-24 rounded-full object-cover ring-2 ring-primary/60"
	/>
	<div>
		<h1 class="text-2xl font-bold tracking-tight">{site.name}</h1>
		<p class="mt-1 text-sm text-foreground/70">{site.tagline}</p>
	</div>
	{
		site.intros?.length ? (
			<ul class="flex flex-wrap justify-center gap-x-3 gap-y-1 text-xs text-foreground/60">
				{site.intros.map((intro) => (
					<li>{intro}</li>
				))}
			</ul>
		) : null
	}
</header>
