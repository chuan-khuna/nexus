---
import { Icon } from 'astro-icon/components';

interface Props {
	label: string;
	url: string;
	icon?: string;
	hasDescription?: boolean;
}

const { label, url, icon, hasDescription = false } = Astro.props;
---

<a
	href={url}
	target="_blank"
	rel="noopener noreferrer"
	class="group flex items-center gap-3 rounded-lg border border-border bg-card px-4 py-3 transition-colors hover:border-primary hover:bg-primary/10"
>
	{icon ? <Icon name={icon} class="size-5 shrink-0 text-primary" /> : null}
	<span class="min-w-0 flex-1">
		<span class="block font-medium">{label}</span>
		{
			hasDescription && (
				<span class="mt-0.5 block text-sm text-foreground/60 [&_p]:m-0">
					<slot />
				</span>
			)
		}
	</span>
	<Icon
		name="lucide:arrow-up-right"
		class="size-4 shrink-0 text-foreground/40 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
	/>
</a>
