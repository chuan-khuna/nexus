---
// Compact time block — rendered inside the profile card. The live clock is driven
// by the shared script in index.astro, which updates every [data-timecard].
interface Props {
	title: string;
	timezone?: string; // IANA tz; omit for the visitor's local time
	live?: boolean; // show the green "live" dot
}

const { title, timezone, live = false } = Astro.props;
---

<div data-timecard data-timezone={timezone ?? ''}>
	<div class="flex items-center gap-1.5">
		<span class="text-xs font-medium text-foreground/60">{title}</span>
		{live && <span class="size-2 rounded-full bg-green-500" aria-label="live"></span>}
	</div>
	<time class="mt-0.5 block font-mono text-2xl tabular-nums tracking-tight" data-clock>--:--:--</time>
	<div class="mt-0.5 text-[11px] text-foreground/50">
		<span data-date>&mdash;</span> &middot; <span data-tzlabel>{timezone ?? ''}</span>
	</div>
</div>
